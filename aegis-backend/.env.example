# AEGIS-IoT Multi-Cloud + Local Qwen 2.5 Orchestrator Config
# Fill in any combination of free cloud API keys below.
# The orchestrator automatically falls back across: Groq -> Gemini -> OpenRouter -> Ollama -> Replay.

# 1. Groq Free Cloud API (Fastest for Qwen 2.5 Coder 32B: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-coder-32b

# 2. Google Gemini Free API (AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter Free Router (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 4. Local Ollama (Best Fit Local Model: qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

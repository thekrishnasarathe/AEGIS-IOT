# =============================================================================
# AEGIS-IoT Environment Configuration (.env)
# =============================================================================

# --- Backend Server Settings ---
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# --- LLM Provider API Keys (Free Tier / Optional) ---
# If no keys are provided, AEGIS-IoT gracefully falls back to deterministic
# CVEfixes-guided Stage Insurance synthesis (< 50ms) with zero crashes.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen-2.5-coder-32b

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free

# --- Local Ollama Settings (Optional on-prem) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# --- Frontend Client Settings (Vite) ---
# For local dev leave blank (uses Vite proxy). For production, set to backend URL:
# VITE_API_URL=https://your-backend-service.onrender.com
VITE_API_URL=

# =============================================================================
# AEGIS-IoT .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.*
!.env.example

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Databases & Caches
*.db
*.sqlite*
cache/
exports/

# Dynamic Run State JSONs (preserve benchmark results)
backend/runs/run_*.json

# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Antigravity artifacts
.gemini/
.system_generated/
